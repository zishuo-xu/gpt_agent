{
  "name": "myagent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local coding agent designed for long-running autonomous tasks.",
  "bin": {
    "myagent": "./dist/cli.js"
  },
  "scripts": {
    "build": "npm run build:core && npm run build:web",
    "build:core": "tsc -p tsconfig.json",
    "build:web": "vite build --config web/vite.config.ts",
    "dev": "tsx src/cli.ts",
    "web": "npm run build:web && tsx src/cli.ts --web",
    "test": "tsx --test \"src/**/*.test.ts\" \"tests/**/*.test.ts\" && TSX_TSCONFIG_PATH=web/tsconfig.json tsx --test \"web/src/**/*.test.tsx\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "ajv": "^8.20.0",
    "express": "^5.2.1",
    "hono": "^4.9.0",
    "jsonc-parser": "^3.3.0",
    "lodash": "^4.18.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "happy-dom": "^20.11.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
